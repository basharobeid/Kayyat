# Copy to .env and adjust. Never commit .env.

# --- Backend -------------------------------------------------------------
ENVIRONMENT=development
# SQLite by default; for Postgres: postgresql+psycopg://user:pass@localhost:5432/khayyat
DATABASE_URL=sqlite:///./khayyat.db
# Production refuses to start unless this is a random value of >= 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGINS=http://localhost:3000
PLATFORM_COMMISSION_RATE=0.12

# Not wired up yet (planned integrations):
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT= / S3_ACCESS_KEY= / S3_SECRET_KEY= / S3_BUCKET=khayyat-media
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=
# SMTP_HOST= / SMTP_USER= / SMTP_PASS=
# SENTRY_DSN=

# --- Frontend (put these in frontend/.env.local when running without Docker) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
